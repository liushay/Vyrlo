{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deep Agent Runtime Configuration Schema",
  "type": "object",
  "required": [
    "schema_version",
    "server",
    "llm",
    "sandbox",
    "storage",
    "observability",
    "runtime",
    "middlewares",
    "thresholds"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "api_key_env"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "local", "echo"]
        },
        "model": { "type": "string" },
        "api_key_env": { "type": "string" },
        "base_url": { "type": ["string", "null"] },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "top_p": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "retry_delay": { "type": "number", "minimum": 0.0 },
        "max_context_tokens": { "type": "integer", "minimum": 1 },
        "task_routes": { "type": "object" },
        "fallback_models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model"],
            "properties": {
              "provider": { "type": "string" },
              "model": { "type": "string" },
              "api_key_env": { "type": "string" },
              "base_url": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["local", "docker"] },
        "base_dir": { "type": ["string", "null"] },
        "fallback_modes": {
          "type": "array",
          "items": { "type": "string", "enum": ["local", "docker"] }
        },
        "image": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": { "type": "string", "enum": ["memory", "sqlite"] },
        "db_path": { "type": "string" },
        "event_table": { "type": "string" },
        "session_table": { "type": "string" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics_enabled": { "type": "boolean" },
        "metrics_path": { "type": "string" },
        "log_level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "max_delegation_depth": { "type": "integer", "minimum": 0 }
      }
    },
    "middlewares": {
      "type": "object",
      "description": "中间件开关（按名称启用/禁用）",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "conversation_recorder",
              "memory_lifecycle",
              "memory_injector",
              "memory_consolidation",
              "tool_result_feedback",
              "context_compressor",
              "loop_guard",
              "cost_guard",
              "observability",
              "sandbox",
              "safety_guard",
              "skill_injection",
              "skill_observation",
              "delegation",
              "orchestrator"
            ]
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "description": "运行时阈值（来自 calibration-v2.md 的校准结论）",
      "additionalProperties": false,
      "properties": {
        "cost_guard_max_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "CostGuard 单会话 token 预算上限。0 表示不限。校准值 1631（P95）。",
          "default": 1631
        },
        "cost_guard_max_cost": {
          "type": "number",
          "minimum": 0.0,
          "description": "CostGuard 单会话费用上限（USD）。0 表示不限。待校准。",
          "default": 0.0
        },
        "context_compressor_threshold_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "上下文压缩触发比例阈值。校准值 0.8（中置信度）。",
          "default": 0.8
        },
        "skill_selector_score_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "技能选择器质量过滤门槛。校准值 0.3（中置信度）。",
          "default": 0.3
        },
        "score_delta_min_delta": {
          "type": "number",
          "minimum": 0.0,
          "description": "技能变异打分最小变化门槛。待校准。",
          "default": 0.0
        },
        "memory_consolidation_threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "episodic→semantic 合并触发条数。待校准。",
          "default": 10
        }
      }
    }
  }
}